filters:
  and:
    - file.hasProperty("status")
formulas:
  rank: if(note.priority == "high", 1, if(note.priority == "normal", 2, 3))
views:
  - type: kanban
    name: Board
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - maybe
      - backlog
      - next
      - doing
      - review
      - done
    order:
      - title
      - priority
    sort:
      - property: formula.rank
        direction: ASC
      - property: created
        direction: ASC
  - type: table
    name: All tickets
    order:
      - title
      - status
      - priority
      - created
      - file.name
    sort:
      - property: status
        direction: ASC
      - property: formula.rank
        direction: ASC
